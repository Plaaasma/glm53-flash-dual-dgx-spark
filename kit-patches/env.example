# 2x DGX Spark: gx10-a400 (head) + SparkyPoo (worker), CX7 fabric 169.254/16
HEAD_IP=169.254.146.160
WORKER_IP=169.254.152.37

# Both nodes: fabric IP lives on enp1s0f1np1 <-> rocep1s0f1 (verified via ip -br a
# + /sys/class/infiniband; kit default assumed worker f0 which is DOWN here).
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f1
# GID index 3 carries ::ffff:<fabric ip> on BOTH nodes (checked in sysfs).
NCCL_IB_GID_INDEX=3

# Uncensored EXL3 re-encode (orcarouter FP8 lineage). Staged locally as a
# hardlinked HF-cache snapshot on both nodes -- no download will trigger.
MODEL=neko-legends/GLM-5.3-Flash-Uncensored-EXL3
MODEL_FALLBACK=neko-legends/GLM-5.3-Flash-Uncensored-EXL3
MODEL_REVISION=1fac3dbe6269a399ce5378261cdf250fde706180
# neko encode ships 92 weight shards (kit default 120 is for the brandonmusic cut)
EXPECTED_SHARDS=92
HF_TOKEN=hf_YOUR_TOKEN_HERE

IMAGE=glm53-flash-sm121:local-0831
PORT=8888
TP=2
NNODES=2
MASTER_PORT=29521
QUANTIZATION=exl3
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
# GPU 128-row tiles for fat prefill experts. Default 0 falls back to the
# per-expert python loop, whose per-expert .item() syncs (~250/layer x 45
# layers) wedged the engine for minutes under 50-100K prompts (2026-09-01,
# py-spy confirmed both ranks in apply_exl3_python_loop). Decode never
# reaches either path (tokens <= temp rows short-circuits above it).
EXL3_MOE_ROW_TILE=1
# 256: most fat prefill experts fit the single fused launch (128 forced ~4x
# tile passes per hot expert -- measured +47%% wall on the 13.5K fat probe).
# Tiles remain the safety net past 256.
EXL3_TEMP_ROWS_FUSED=192
# Keep the id every existing client (hermes, opencode) already uses.
SERVED_MODEL_NAME=glm-5.3-flash

SPEC_METHOD=mtp
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2
MTP_TOKENS=3
MAX_MODEL_LEN=900000
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEM_UTIL=0.875
KV_CACHE_DTYPE=fp8
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":32,"video":1}'

# Target checkpoint is ALREADY weight-level abliterated -- runtime edit off.
ABLIT=0

GLM53_BOOT_SHAPE_WARMUP=0
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=128
# NVFP4 KV pool: 288 B/token vs fp8_ds_mla 656 -> ~2.28x tokens. Rollback: 0.
GLM53_NVFP4_KV=1
USE_HOST_NCCL=0
CG_ESTIMATE=1
NCCL_DEBUG=WARN
# Pin the KV pool to EXACTLY 8 x 262,144 = 2,097,152 tokens (8,055 B/token
# effective, measured). Without the pin, the auto-sizer converts every saved
# transient into more pool and keeps the boot trough pinned at the watchdog
# threshold (tripped at 0.74 then 0.58 GiB on 2026-09-02).
# Pin the pool to 8 x 262,144 tokens (+1%); MTP-mode auto-size (3.16M) eats
# the whole machine to the watchdog line otherwise. Surplus becomes margin.
EXTRA_ARGS="--kv-cache-memory 9500000000"
